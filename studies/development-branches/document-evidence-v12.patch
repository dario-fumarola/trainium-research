+++ b/tests/test_document_evidence_data.py
@@ -0,0 +1,54 @@
+import copy
+
+import pytest
+
+from train.document_evidence_data import question_projection,render,supplied_support
+
+
+class InputOnly(dict):
+    def __getitem__(self,key):
+        if key not in {'id','composed_question_text','contexts','wikipedia_title','paragraph_text'}:
+            raise AssertionError('Generation read an offline label: '+key)
+        return super().__getitem__(key)
+
+
+def row():
+    return dict(id='document-question',composed_question_text='Which city hosted the event?',
+        question_text='[[CQS]] 0 [[CQE]] hidden composition template',
+        answer_text='Lyon',decomposed_instances=['gold hidden step'],
+        contexts=[dict(wikipedia_title='Event',paragraph_text='The event was held in Lyon.',
+                       is_supporting=True,retrieval_score=1.,primary=True),
+                  dict(wikipedia_title='Other event',paragraph_text='A different event took place in Bern.',
+                       is_supporting=False,retrieval_score=0.,primary=False)])
+
+
+def test_generation_projection_never_reads_gold_or_retrieval_fields():
+    value=row();value['contexts']=[InputOnly(c) for c in value['contexts']]
+    q=question_projection(InputOnly(value));text=render(q)
+    assert 'Lyon' in text and 'Bern' in text  # BOTH supplied documents remain
+    assert 'gold hidden step' not in text and 'is_supporting' not in text
+    changed=copy.deepcopy(value);changed.update(answer_text='poison',decomposed_instances=[])
+    for c in changed['contexts']:c.update(is_supporting=False,retrieval_score=999.,primary=False)
+    assert question_projection(changed)==q and render(question_projection(changed))==text
+
+
+def test_offline_support_copies_only_the_visible_paragraphs():
+    value=row();q=question_projection(value);support=supplied_support(value,q)
+    assert support=='[1] Event\nThe event was held in Lyon.'
+    value['answer_text']='An incorrect hidden answer'
+    assert supplied_support(value,q)==support
+    with pytest.raises(ValueError):
+        supplied_support(value,{**q,'question':'A different question'})
+
+
+def test_render_rejects_unprojected_supervised_row():
+    with pytest.raises(ValueError):render(row())
+    q=question_projection(row());q['contexts'][0]['is_supporting']=True
+    with pytest.raises(ValueError):render(q)
+
+
+def test_raw_composition_program_is_not_a_natural_question_fallback():
+    value=row();value['composed_question_text']='[[CQS]] 0 [[CQE]] A program'
+    with pytest.raises(ValueError):question_projection(value)
+    del value['composed_question_text']
+    with pytest.raises(KeyError):question_projection(value)
diff --git a/train/document_evidence_data.py b/train/document_evidence_data.py
new file mode 100644
index 0000000000000000000000000000000000000000..e2a92040ac4194b27fa50c3693a42ced2698d6e2
--- /dev/null
+++ b/train/document_evidence_data.py
@@ -0,0 +1,49 @@
+"""Author-distributed MuSiQue TRAIN: evidence task input/label separation.
+
+Only the question and visible paragraphs enter the model. Answers, gold
+decompositions, supporting flags and retrieval scores are offline annotations.
+This prepares a candidate diagnostic, not a model or evaluation release.
+"""
+
+
+def question_projection(row):
+    """Read only the four allowed textual input fields; labels may be poisoned."""
+    contexts = [{'title': c['wikipedia_title'], 'text': c['paragraph_text']}
+                for c in row['contexts']]
+    # Authors' raw question_text is a composition program with [[CQS]] and
+    # [[RQS]] placeholders. The authored natural-language question is here.
+    result = dict(item_id=row['id'], question=row['composed_question_text'], contexts=contexts)
+    if (not isinstance(result['item_id'], str) or not result['item_id']
+            or not isinstance(result['question'], str) or not result['question'].strip()
+            or any(marker in result['question'] for marker in ('[[CQS]]','[[RQS]]','[[CQE]]'))
+            or not contexts or any(not isinstance(v,str) or not v.strip()
+                                   for c in contexts for v in c.values())):
+        raise ValueError('An actual question and complete visible title/text paragraphs are required')
+    return result
+
+
+def render(question):
+    if set(question) != {'item_id','question','contexts'}:
+        raise ValueError('Only the explicit question/context projection may be rendered')
+    paragraphs = []
+    for index, context in enumerate(question['contexts'],1):
+        if set(context) != {'title','text'}:
+            raise ValueError('Do not expose source support or retrieval annotations')
+        paragraphs.append(f'[{index}] {context["title"]}\n{context["text"]}')
+    return 'Documents:\n' + '\n\n'.join(paragraphs) + '\n\nQuestion: ' + question['question'] + '\n'
+
+
+def supplied_support(row, question):
+    """An OFFLINE oracle consisting solely of paragraphs visible to the model.
+
+    It can contain the final answer because the answer is already in the input
+    documents. Gold evidence selection is privileged supervision, not a deployed
+    note and not proof that the prefix-only model can select the same evidence.
+    """
+    if question_projection(row) != question:
+        raise ValueError('Evidence labels must refer to the exact visible input')
+    support = [i for i,c in enumerate(row['contexts']) if c['is_supporting']]
+    if not support:
+        raise ValueError('Supporting paragraphs are required for this answerable-task candidate')
+    return '\n\n'.join(f'[{i+1}] {question["contexts"][i]["title"]}\n'
+                       + question['contexts'][i]['text'] for i in support)
